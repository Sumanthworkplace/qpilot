generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  papers    Paper[]
  schools   School[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model School {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  logoUrl   String?
  papers    Paper[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Paper {
  id               String      @id @default(cuid())
  title            String
  subject          String
  totalMarks       Int
  totalHours       Float
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  schoolId         String?
  school           School?     @relation(fields: [schoolId], references: [id])
  questions        Question[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  questionSplitup  String
}

model Question {
  id           String      @id @default(cuid())
  paperId      String
  paper        Paper       @relation(fields: [paperId], references: [id])
  type         String
  text         String
  options      String?
  answer       String
  marks        Int
  order        Int
  imageUrl     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
